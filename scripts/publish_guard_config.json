    "lesson_ledger": {
      "cmd": [
        "{python}",
        "scripts/lesson_ledger.py",
        "check"
      ],
      "timeout_s": 60,
      "what": "LS-11 one lesson ledger: every number on Lessons, Word Bank and Grammar is a count over the marked transcript; every producer item is one mark; every disagreement is settled by a rule or listed for Medi"
    },
    "medi_corrections": {
      "cmd": [
        "{python}",
        "scripts/medi_corrections.py",
        "check"
      ],
      "timeout_s": 60,
      "what": "Medi's transcript corrections: none orphaned, held or quarantined, no rule paused by probation (PR-15; a warning only, never blocks)"
    },
    "foreign_script": {
      "cmd": [
