{
  "about": "Publish guard (Medi decision 7, 2026-09-29). Every push to master publishes the live site (GitHub Pages builds master:/docs), so scripts/publish_guard.py runs these checks right before any `git push`. A REQUIRED check that fails, times out or is missing blocks the push; an ADVISORY check only reports. Edit the two lists to change what blocks. Never move a check to advisory to make a push go through without Medi's yes.",
  "required": [
    "step_failures",
    "clean_tree",
    "json_data",
    "rule_registry",
    "lesson_coverage",
    "review_done",
    "lesson_type_read",
    "taught_words_cross_check",
    "lesson_ledger",
    "accuracy_gates",
    "check_numbers",
    "check_rules",
    "check_pages",
    "arabizi_gaps",
    "recordings_complete",
    "tests_py",
    "tests_node",
    "rehear_rows"
  ],
  "advisory": [
    "review_freshness",
    "data_freshness",
    "medi_corrections",
    "foreign_script"
  ],
  "total_timeout_s": 300,
  "clean_paths": [
    "docs",
    "data/full-audit-2026-09-26.json",
    "data/accuracy",
    "RULE-BOOK.md",
    "data/lesson-work/ledger",
    "data/lesson-work/ledger-amal.json"
  ],
  "commands": {
    "rule_registry": {
      "cmd": [
        "{python}",
        "scripts/rule_registry.py",
        "check"
      ],
      "timeout_s": 60,
      "what": "every correction is a registry entry whose rule is proven: code + a guard test, or the readers' brief + a real moment (RULES.md S6, rules/registry.json)"
    },
    "accuracy_gates": {
      "cmd": [
        "{python}",
        "scripts/accuracy_gates.py",
        "check"
      ],
      "timeout_s": 120,
      "what": "Lessons, Word Bank, Grammar and the audit agree; verified only above the 95% agreement bar"
    },
    "recordings_complete": {
      "cmd": [
        "{python}",
        "scripts/missing_recordings.py"
      ],
      "timeout_s": 60,
      "what": "freshness: every recording of every lesson in the raw archive (ANEES_RAW) is transcribed - none dropped (rule TR-17)"
    },
    "check_numbers": {
      "cmd": [
        "{python}",
        "scripts/check_numbers.py"
      ],
      "timeout_s": 120,
      "what": "every number shown on every page is recomputed from raw and matches"
    },
    "check_rules": {
      "cmd": [
        "{python}",
        "scripts/check_rules.py"
      ],
      "timeout_s": 120,
      "what": "the standing rules (RULES.md + Medi's rules) hold in the data (worker D, eng-audit-d)"
    },
    "check_pages": {
      "cmd": [
        "{python}",
        "scripts/check_pages.py"
      ],
      "timeout_s": 120,
      "what": "page health: links, audio clips, no blank numbers (worker F)"
    },
    "arabizi_gaps": {
      "cmd": [
        "{node}",
        "scripts/arabizi_gaps.cjs"
      ],
      "timeout_s": 60,
      "stdout_must_match": "\\b0 words\\b",
      "what": "no Arabic-only word on the error cards (RULES.md S1)"
    },
    "tests_py": {
      "cmd": [
        "{python}",
        "-m",
        "pytest",
        "-q",
