        "scripts/echo_candidates.py",
        "--foreign-check"
      ],
      "timeout_s": 60,
      "what": "no transcript line shows the engine's language switch (Chinese/Japanese/Russian/Hebrew/Hindi letters) unfixed (TR-25; a warning only)"
