"""Anees experiment 1 (wiki 14, rank-1 workaround): tutor-reaction detector.

Question: after a Medi turn, does what Amal does in the next 2 / 5 / 10 s tell a CORRECTION apart from a control?
Data: data/aug25/gold_selection_v2.json = 20 corrections + 30 controls (10 gap, 10 hesitation, 10 random),
      ElevenLabs Scribe v2 (forced ara) word stream, speakers mapped Medi/Amal by overlap with the dialect reference.
Anchor: the FIRST Medi run touching the gold chunk (chunk start - 3 s .. chunk end); window = [anchor end, +W].
Output: data/aug25/tutor_reaction_results.json (per item features + per window metrics), printed summary.
Run:    python scripts/tutor_reaction_exp.py
"""
import json, io, re, bisect, difflib
from collections import Counter, defaultdict

R = 'data/aug25/'
LESSON_START, LESSON_END = 173.0, 3600.0
EXCLUDE = [(218.0, 259.0), (2440.0, 2452.0)]        # Medi speaking Farsi to his dad
WINDOWS = (2, 5, 10)
TUTOR, LEARNER = 'Amal', 'Medi'

ARABIC = re.compile(r'[؀-ۿ]')
DIACRITICS = re.compile(r'[ً-ْٰـ]')
PUNCT = re.compile(r'[^\w؀-ۿ]+')
FILLER = re.compile(r"^[\W_]*(u+m+|u+h+|u+h+m+|h+m+|m+m+|e+r+|a+h+|أ*م+|ا+م+|آ+|ا{2,}|ه+م+|إ+م+|ء*م+)[\W_]*$", re.I)
CONFIRM = re.compile(r"^[\W_]*(m+h+m+|mm-?hmm|uh-?huh|a+h+a+|yes|yeah|yep|yup|exactly|correct|perfect|bravo|ممتاز|أيوه|ايوه|ايوا|أيوا|صح|بالظبط|مظبوط|برافو|عظيم)[\W_]*$", re.I)

NEG = {'la', 'laa', 'no', 'nope', 'not', 'mish', 'mush', 'لا', 'لأ', 'لاء', 'مش', 'مو'}
META_EN = {'say', 'says', 'said', 'instead', 'means', 'mean', 'meaning', 'use', 'takes', 'take', 'arabic', "don't", 'dont',
           'should', 'general', 'because', 'preposition', 'verb', 'plural', 'feminine', 'masculine'}
ELICIT = {'شو', 'ايش', 'إيش', 'كيف', 'ليش', 'وين', 'مين', 'what', 'how', 'why', 'which'}
STOP = {'في', 'من', 'على', 'عن', 'مع', 'هذا', 'هاد', 'هاي', 'هذه', 'انا', 'أنا', 'انت', 'إنت', 'هو', 'هي', 'احنا', 'إحنا', 'هم', 'همي',
        'بس', 'و', 'يعني', 'شو', 'ايش', 'إيش', 'كيف', 'ليش', 'لما', 'اذا', 'إذا', 'كمان', 'كتير', 'هيك', 'هلأ', 'هلق', 'تمام', 'طيب',
        'خلاص', 'اه', 'آه', 'ايوه', 'أيوه', 'ماشي', 'لا', 'مش', 'ما', 'يا', 'الله', 'ok', 'okay', 'the', 'and', 'you', 'yes', 'it', 'is',
        'to', 'in', 'of', 'a', 'so', 'like', 'that', 'this', 'i', 'we', 'no', 'or', 'but', 'اللي', 'الي', 'كل', 'شي', 'اشي', 'إشي', 'فيه', 'فيش'}


def norm(w):
    w = DIACRITICS.sub('', w.lower())
    w = PUNCT.sub('', w)
    w = w.replace('أ', 'ا').replace('إ', 'ا').replace('آ', 'ا').replace('ة', 'ه').replace('ى', 'ي')
    return w


def is_content_ar(n):
    return bool(ARABIC.search(n)) and len(n) >= 3 and n not in STOP


# ---------- words + speakers ----------
def load_ref():
    d = json.load(io.open(R + 'turns.json', encoding='utf-8'))['words']
    return sorted(({'s': w['s'], 'e': w['e'], 'spk': w['spk']} for w in d), key=lambda w: w['s'])


def load_eleven():
    d = json.load(io.open(R + 'eleven_scribe_ara.json', encoding='utf-8'))['words']
    return [{'s': w['start'], 'e': w['end'], 'spk': w.get('speaker_id', '?'), 'w': w['text'].replace('�', '')}
            for w in d if w['type'] == 'word']


def speaker_map(words, ref):
    starts = [w['s'] for w in ref]
    votes = defaultdict(Counter)
    for w in words:
        mid = (w['s'] + w['e']) / 2
        i = bisect.bisect_right(starts, mid) - 1
        if 0 <= i < len(ref) and ref[i]['e'] + 0.3 >= mid:
            votes[w['spk']][ref[i]['spk']] += 1
    return {lab: c.most_common(1)[0][0] for lab, c in votes.items()}


def runs_of(words, gap=1.5):
    """Speaker runs: same speaker, no silence longer than `gap` inside a run."""
    runs = []
    for w in words:
        if runs and runs[-1]['spk'] == w['spk'] and w['s'] - runs[-1]['e'] <= gap:
            runs[-1]['words'].append(w); runs[-1]['e'] = max(runs[-1]['e'], w['e'])
        else:
            runs.append({'spk': w['spk'], 's': w['s'], 'e': w['e'], 'words': [w]})
    return runs


def anchor_for(item, runs, words):
    """Anchor v2 = the Medi -> Amal hand-off at the gold chunk: end of Medi's last word before Amal's first word
    that starts in [chunk start - 1, chunk end + 5]. Learner vocabulary = Medi's words in the 8 s before that.
    Fallback (no Amal word there) = first Medi run touching [start - 3, end]."""
    st, en = item['start'], item['end']
    amal_first = next((w for w in words if w['spk'] == TUTOR and st - 1.0 <= w['s'] <= en + 5.0), None)
    if amal_first:
        before = [w for w in words if w['spk'] == LEARNER and st - 8.0 <= w['e'] <= amal_first['s'] + 0.05]
        if before:
            e = max(w['e'] for w in before)
            vocab = [w for w in words if w['spk'] == LEARNER and e - 8.0 <= w['e'] <= e]
            return {'s': min(w['s'] for w in vocab), 'e': e, 'words': vocab, 'mode': 'handoff'}
    for r in runs:
        if r['spk'] == LEARNER and r['e'] >= st - 3.0 and r['s'] <= en:
            return {'s': r['s'], 'e': r['e'], 'words': r['words'], 'mode': 'first-run'}
    r = min((r for r in runs if r['spk'] == LEARNER), key=lambda r: abs(r['e'] - st))
    return {'s': r['s'], 'e': r['e'], 'words': r['words'], 'mode': 'nearest'}


# ---------- features ----------
def features(item, anchor, words, W):
    t0 = anchor['e']
    win = [w for w in words if t0 < w['s'] <= t0 + W]
    amal = [w for w in win if w['spk'] == TUTOR]
    learner_ar = {norm(w['w']) for w in anchor['words'] if is_content_ar(norm(w['w']))}
    amal_ar = [norm(w['w']) for w in amal if is_content_ar(norm(w['w']))]
    amal_all = [norm(w['w']) for w in amal]

    f = {}
    f['neg'] = any(n in NEG for n in amal_all)
    f['repeat'] = any(n in learner_ar for n in amal_ar)
    f['recast'] = any(n not in learner_ar and max((difflib.SequenceMatcher(None, n, l).ratio() for l in learner_ar), default=0) >= 0.6
                      for n in amal_ar)
    f['meta_en'] = any(n in META_EN for n in amal_all)
    f['elicit'] = any(n in ELICIT for n in amal_all) or any(w['w'].rstrip().endswith(('?', '؟')) for w in amal)
    first = next((w for w in amal if not FILLER.match(w['w'])), None)
    f['confirm_open'] = bool(first and CONFIRM.match(first['w']))
    # uptake: Medi, after Amal's first word in the window, repeats/approximates an Amal content word
    up = False
    if first:
        later_medi = [norm(w['w']) for w in win if w['spk'] == LEARNER and w['s'] > first['s']]
        later_medi = [n for n in later_medi if is_content_ar(n)]
        up = any(max((difflib.SequenceMatcher(None, m, a).ratio() for a in amal_ar), default=0) >= 0.75 for m in later_medi)
    f['uptake'] = up
    f['amal_words'] = len(amal)
    f['latency'] = round(amal[0]['s'] - t0, 2) if amal else None
    f['amal_text'] = ' '.join(w['w'] for w in amal)
    return f


BIN = ['neg', 'repeat', 'recast', 'meta_en', 'elicit', 'uptake', 'confirm_open']
RULES = {
    'neg|recast|repeat': lambda f: f['neg'] or f['recast'] or f['repeat'],
    'neg|recast|repeat|meta_en': lambda f: f['neg'] or f['recast'] or f['repeat'] or f['meta_en'],
    'neg|recast': lambda f: f['neg'] or f['recast'],
    '(neg|recast|repeat) & !confirm_open': lambda f: (f['neg'] or f['recast'] or f['repeat']) and not f['confirm_open'],
    'recast|uptake': lambda f: f['recast'] or f['uptake'],
}


def prf(pred, y):
    tp = sum(1 for p, t in zip(pred, y) if p and t); fp = sum(1 for p, t in zip(pred, y) if p and not t)
    fn = sum(1 for p, t in zip(pred, y) if not p and t)
    P = tp / (tp + fp) if tp + fp else 0.0; Rc = tp / (tp + fn) if tp + fn else 0.0
    F = 2 * P * Rc / (P + Rc) if P + Rc else 0.0
    return {'tp': tp, 'fp': fp, 'fn': fn, 'precision': round(P, 3), 'recall': round(Rc, 3), 'f1': round(F, 3)}


def loo_logreg(X, y):
    """Leave-one-out logistic regression; returns metrics + AUC. Honest estimate for 50 rows."""
    import numpy as np
    from sklearn.linear_model import LogisticRegression
    X = np.array(X, dtype=float); y = np.array(y, dtype=int)
    prob = np.zeros(len(y))
    for i in range(len(y)):
        m = np.ones(len(y), bool); m[i] = False
        clf = LogisticRegression(C=1.0, max_iter=1000).fit(X[m], y[m])
        prob[i] = clf.predict_proba(X[i:i + 1])[0, 1]
    from sklearn.metrics import roc_auc_score
    out = prf(prob >= 0.5, y)
    out['auc'] = round(float(roc_auc_score(y, prob)), 3)
    return out, prob.round(3).tolist()


def main():
    sel = json.load(io.open(R + 'gold_selection_v2.json', encoding='utf-8'))
    ref = load_ref()
    words = load_eleven()
    mp = speaker_map(words, ref)
    for w in words:
        w['spk'] = mp.get(w['spk'], w['spk'])
    words = [w for w in words if LESSON_START <= w['s'] <= LESSON_END and not any(a <= w['s'] <= b for a, b in EXCLUDE)]
    runs = runs_of(words)
    items = [g for g in sel if LESSON_START <= (g['start'] or 0) <= LESSON_END and not any(a <= g['start'] <= b for a, b in EXCLUDE)]
    y = [g['kind'] == 'correction' for g in items]
    corr_spans = [(g['start'], g['end']) for g in items if g['kind'] == 'correction']
    near = [g['kind'] != 'correction' and any(a - 6.0 <= g['start'] <= b + 6.0 for a, b in corr_spans) for g in items]
    clean = [not n for n in near]
    print(f'speaker map {mp}; items {len(items)} = {Counter(g["kind"] for g in items)}')

    results = {'speaker_map': mp, 'n_items': len(items), 'controls_near_a_correction': [g['idx'] for g, n in zip(items, near) if n], 'kinds': dict(Counter(g['kind'] for g in items)), 'windows': {}, 'items': []}
    per_item = [{'idx': g['idx'], 'kind': g['kind'], 'why': g['why'], 'chunk': [g['start'], g['end']]} for g in items]
    for W in WINDOWS:
        feats = []
        for g, row in zip(items, per_item):
            a = anchor_for(g, runs, words)
            f = features(g, a, words, W)
            row.setdefault('anchor', [round(a['s'], 2), round(a['e'], 2), ' '.join(w['w'] for w in a['words']), a['mode']])
            row[f'w{W}'] = f
            feats.append(f)
        block = {'features': {}, 'rules': {}}
        for k in BIN:
            block['features'][k] = prf([f[k] for f in feats], y)
        for name, fn in RULES.items():
            block['rules'][name] = prf([fn(f) for f in feats], y)
        block['rules_clean_controls'] = {name: prf([fn(f) for f, c in zip(feats, clean) if c], [t for t, c in zip(y, clean) if c])
                                         for name, fn in RULES.items()}
        block['features_clean_controls'] = {k: prf([f[k] for f, c in zip(feats, clean) if c], [t for t, c in zip(y, clean) if c]) for k in BIN}
        # continuous features: mean by class
        block['means'] = {}
        for k in ('amal_words', 'latency'):
            for cls, lab in ((True, 'correction'), (False, 'control')):
                vals = [f[k] for f, t in zip(feats, y) if t == cls and f[k] is not None]
                block['means'][f'{k}_{lab}'] = round(sum(vals) / len(vals), 2) if vals else None
        X = [[float(f[k]) for k in BIN] + [f['amal_words'], (f['latency'] if f['latency'] is not None else W)] for f in feats]
        try:
            block['loo_logreg'], probs = loo_logreg(X, y)
            for row, p in zip(per_item, probs):
                row[f'w{W}']['loo_prob'] = p
        except Exception as e:                       # sklearn missing -> rules only
            block['loo_logreg'] = {'error': str(e)}
        results['windows'][str(W)] = block
    results['items'] = per_item
    json.dump(results, io.open(R + 'tutor_reaction_results.json', 'w', encoding='utf-8'), ensure_ascii=False, indent=1)

    # ---------- summary ----------
    print('\n=== per feature (precision / recall / F1), correction vs 30 controls ===')
    print(f'{"feature":36s}' + ''.join(f'{"W=" + str(W) + "s":>22s}' for W in WINDOWS))
    for k in BIN + list(RULES):
        line = f'{k:36s}'
        for W in WINDOWS:
            b = results['windows'][str(W)]
            m = b['features'].get(k) or b['rules'][k]
            line += f'{m["precision"]:>7.2f}{m["recall"]:>7.2f}{m["f1"]:>8.2f}'
        print(line)
    print('\n=== leave-one-out logistic regression (all features) ===')
    for W in WINDOWS:
        m = results['windows'][str(W)]['loo_logreg']
        print(f'W={W:2d}s  ' + (f'P {m["precision"]:.2f}  R {m["recall"]:.2f}  F1 {m["f1"]:.2f}  AUC {m["auc"]:.2f}' if 'auc' in m else m['error']))
    print('\n=== same, controls within 6 s of a correction removed (%s) ===' % results['controls_near_a_correction'])
    for k in BIN + list(RULES):
        line = f'{k:36s}'
        for W in WINDOWS:
            b = results['windows'][str(W)]
            m = b['features_clean_controls'].get(k) or b['rules_clean_controls'][k]
            line += f'{m["precision"]:>7.2f}{m["recall"]:>7.2f}{m["f1"]:>8.2f}'
        print(line)
    print('\n=== means ===')
    for W in WINDOWS:
        print(f'W={W:2d}s', results['windows'][str(W)]['means'])
    print('\nwrote', R + 'tutor_reaction_results.json')


if __name__ == '__main__':
    main()
